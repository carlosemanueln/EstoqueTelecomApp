<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EstoqueTelecomApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:EstoqueTelecomApp.Views"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Categorias (Fibra e 5G)">
            <ShellContent ContentTemplate="{DataTemplate views:CategoriaView}" />
        </Tab>

        <Tab Title="Ativos de Telecom">
            <ShellContent ContentTemplate="{DataTemplate views:EquipamentoView}" />
        </Tab>
        <Tab Title="Campo (Offline)">
            <ShellContent ContentTemplate="{DataTemplate views:TrabalhoCampoView}" />
        </Tab>
    </TabBar>

</Shell>